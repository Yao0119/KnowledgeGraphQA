# ============================================================
# 环境变量示例
# 复制为 .env（根目录或 backend/ 下均可，.env 已被 .gitignore 忽略）
# 后端启动时会自动加载（backend/core/config.py，已存在的环境变量优先）
# ============================================================

# ------------------------------------------------------------
# LLM 后端选择
#   deepseek（默认）—— 调用云端 API
#   ollama          —— 调用本地 Ollama
# ------------------------------------------------------------
# LLM_PROVIDER=deepseek

# ------------------------------------------------------------
# DeepSeek API（provider=deepseek 时必填）
# 到 https://platform.deepseek.com/api_keys 申请
# 留空也能启动，但问答/推理/预测会明确提示"未配置 DEEPSEEK_API_KEY"
# ------------------------------------------------------------
DEEPSEEK_API_KEY=

# 模型名。官方文档：用 `deepseek-flash`，它对应的模型版本就是 DeepSeek-V4.1-Flash；
# 旧名 `deepseek-v4-flash` 仍被接受（模型已下线，请求由 V4.1-Flash 承接）；
# 需要更强推理可用 `deepseek-v4-pro`。
DEEPSEEK_MODEL=deepseek-flash

# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 思考模式。DeepSeek 服务端**默认开启**思考；本项目默认显式关闭（更快更省）。
# 想要思维链时改成 enabled，并可用 effort 调节强度。
DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high

# 请求超时（秒）
# DEEPSEEK_TIMEOUT=120

# 通用生成参数
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1024

# ------------------------------------------------------------
# 本地 Ollama（provider=ollama 时使用）
# ------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen:1.8b

# ------------------------------------------------------------
# 安全（生产环境必须修改）
# 未设置时 backend/core/config.py 用的是 CHANGE_ME_* / change-this-secret-key 占位符，
# 启动时会打印警告提醒。
# ------------------------------------------------------------
# 换成一串足够长的随机字符串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
# SECRET_KEY=
# 静态管理员令牌（仅本地脚本/测试需要；网页端用的是登录返回的 JWT）
# ADMIN_TOKEN=
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# MySQL / Neo4j
# ⚠️ 请填你自己的口令。config.py 里**不再提供可用的默认口令**，
#    只放 CHANGE_ME_* 占位符，避免真实密码被提交进版本库。
# ------------------------------------------------------------
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=kg_qa_system
# MYSQL_PORT=3306
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# ------------------------------------------------------------
# CORS 允许的前端来源（逗号分隔）
# ------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# 知识图谱检索调优
# 检索策略：先按实体名字面命中，未命中再退回关键词 n-gram 召回
# ------------------------------------------------------------
# 单次提问参与匹配的候选词上限
# KG_MAX_TERMS=32
# 单次检索返回的三元组上限
# KG_MAX_TRIPLES=25
# 是否取实体的全部关联关系（含入边，即 1 跳邻居扩展）
# KG_EXPAND_NEIGHBORS=true
