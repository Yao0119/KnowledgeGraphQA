<view class="page customers-page">
  <view class="customers-header safe-top"><text class="eyebrow">ADMIN / CUSTOMERS</text><text class="customers-title">客户管理</text><text class="customers-desc">管理员查看客户账户、状态和最近访问记录。</text></view>
  <view class="section customers-content"><view class="customer-stats"><view class="customer-stat card"><text>3</text><text>客户账户</text></view><view class="customer-stat card"><text>2</text><text>当前正常</text></view></view><view class="section-title"><text>客户列表</text><text>演示数据</text></view><view class="customer-list card"><view wx:for="{{customers}}" wx:key="name" class="customer-row" bindtap="showCustomer" data-name="{{item.name}}"><view class="customer-avatar">{{item.initial}}</view><view class="customer-copy"><text>{{item.name}}</text><text>{{item.email}}</text></view><view class="customer-state"><text>{{item.status}}</text><text>{{item.lastSeen}}</text></view><text class="customer-arrow">›</text></view></view></view>
</view>
