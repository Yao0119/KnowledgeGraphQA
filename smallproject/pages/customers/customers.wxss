.customers-header { padding: 32rpx; background: #0e1b2a; color: #f5f7fa; }.customers-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }.customers-desc { display: block; margin-top: 14rpx; color: #9cb0c0; font-size: 24rpx; line-height: 1.6; }.customers-content { padding-top: 28rpx; }.customer-stats { display: flex; gap: 16rpx; margin-bottom: 32rpx; }.customer-stat { display: flex; flex: 1; align-items: center; flex-direction: column; padding: 24rpx 10rpx; }.customer-stat text:first-child { color: #102235; font-size: 38rpx; font-weight: 700; }.customer-stat text:last-child { margin-top: 6rpx; color: #83919d; font-size: 21rpx; }.customer-list { overflow: hidden; }.customer-row { display: flex; align-items: center; padding: 22rpx 18rpx; border-bottom: 1rpx solid #edf1f3; }.customer-row:last-child { border-bottom: 0; }.customer-avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 16rpx; border-radius: 18rpx; color: #0e1b2a; background: #11d6c5; font-size: 24rpx; font-weight: 700; }.customer-copy { display: flex; flex: 1; flex-direction: column; }.customer-copy text:first-child { color: #304656; font-size: 27rpx; }.customer-copy text:last-child { margin-top: 6rpx; color: #8998a2; font-size: 20rpx; }.customer-state { display: flex; align-items: flex-end; flex-direction: column; margin-right: 12rpx; }.customer-state text:first-child { color: #0da99d; font-size: 21rpx; }.customer-state text:last-child { margin-top: 6rpx; color: #9ba7af; font-size: 19rpx; }.customer-arrow { color: #a7b2b9; font-size: 32rpx; }
