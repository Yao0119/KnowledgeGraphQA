.dual-header { display: flex; align-items: flex-end; justify-content: space-between; padding: 32rpx 32rpx 30rpx; background: #0e1b2a; color: #f5f7fa; }.dual-title { display: block; margin-top: 12rpx; font-size: 44rpx; font-weight: 700; }.dual-note { color: #11d6c5; font-size: 21rpx; }.dual-content { padding-top: 28rpx; }.selector { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 26rpx; }.selector-label { display: block; color: #81909d; font-size: 21rpx; }.selector-value { display: block; margin-top: 6rpx; color: #102235; font-size: 30rpx; font-weight: 700; }.selector-arrow { color: #0da99d; font-size: 36rpx; }.mapping-banner { display: flex; align-items: center; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #ccefeb; border-radius: 18rpx; background: #edfcfa; }.mapping-line { width: 4rpx; height: 52rpx; margin-right: 18rpx; border-radius: 8rpx; background: #11d6c5; }.mapping-core { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin-right: 14rpx; border-radius: 50%; color: #0e1b2a; background: #11d6c5; font-size: 25rpx; }.mapping-title { display: block; color: #167d76; font-size: 25rpx; font-weight: 700; }.mapping-desc { display: block; margin-top: 4rpx; color: #58908c; font-size: 20rpx; }.layer-grid { display: flex; gap: 16rpx; margin-top: 24rpx; }.layer-panel { flex: 1; padding: 20rpx 16rpx; }.layer-heading { display: flex; align-items: center; margin-bottom: 16rpx; color: #334858; font-size: 24rpx; font-weight: 700; }.layer-code { margin-left: auto; color: #a0adb5; font-size: 19rpx; }.layer-dot { width: 14rpx; height: 14rpx; margin-right: 8rpx; border-radius: 50%; }.cn-dot { background: #f26b5e; }.en-dot { background: #3f9ae6; }.layer-node { display: flex; align-items: center; padding: 14rpx 0; border-top: 1rpx solid #edf1f3; }.layer-node-mark { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-right: 10rpx; border-radius: 10rpx; color: #71818d; background: #f0f4f6; font-size: 18rpx; }.layer-node-name { display: block; overflow: hidden; max-width: 190rpx; color: #2e4354; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.layer-node-type { display: block; margin-top: 3rpx; color: #98a5ad; font-size: 18rpx; }.relation-title { margin-top: 30rpx; }.relation-card { overflow: hidden; }.relation-row { display: flex; align-items: center; padding: 18rpx 20rpx; border-bottom: 1rpx solid #edf1f3; color: #435765; font-size: 21rpx; }.relation-row:last-child { border-bottom: 0; }.relation-row text { flex: 1; }.relation-row text:nth-child(2) { color: #0da99d; text-align: center; }.relation-row text:last-child { color: #3f9ae6; text-align: right; }.detail-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(10,25,39,.48); }.detail-sheet { width: 100%; padding: 34rpx 34rpx 50rpx; border-radius: 30rpx 30rpx 0 0; background: #fff; }.detail-kicker { display: block; color: #7f8e9b; font-size: 20rpx; letter-spacing: 2rpx; }.detail-name { display: block; margin-top: 12rpx; color: #102235; font-size: 38rpx; font-weight: 700; }.detail-type { display: block; margin-top: 10rpx; color: #0da99d; font-size: 23rpx; }.detail-close { margin-top: 30rpx; padding: 18rpx; border-radius: 16rpx; color: #0e1b2a; background: #e7faf7; text-align: center; font-size: 25rpx; }
