.graph-header {
  padding: 32rpx 32rpx 30rpx;
  background: #0e1b2a;
  color: #f5f7fa;
}
.graph-header-row { display: flex; align-items: flex-end; justify-content: space-between; }
.graph-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }
.graph-count { color: #8ca3b4; font-size: 22rpx; }
.search-box { display: flex; align-items: center; height: 82rpx; margin-top: 28rpx; padding: 0 24rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 18rpx; background: rgba(255,255,255,.07); }
.search-icon { margin-right: 16rpx; color: #11d6c5; font-size: 40rpx; line-height: 1; }
.search-box input { flex: 1; color: #f5f7fa; font-size: 25rpx; }
.search-placeholder { color: #7f96a7; }
.graph-content { padding-top: 28rpx; }
.filter-scroll { margin: 0 -32rpx; padding-left: 32rpx; width: calc(100% + 64rpx); white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding-right: 32rpx; }
.filter { padding: 14rpx 22rpx; border: 1rpx solid #dce5ea; border-radius: 40rpx; color: #7f8e9b; background: #fff; font-size: 23rpx; }
.filter-active { border-color: #11d6c5; color: #0b8f85; background: #e5faf7; }
.graph-map { position: relative; overflow: hidden; height: 390rpx; margin-top: 26rpx; background: #102235; }
.map-grid { position: absolute; inset: 0; opacity: .24; background-image: linear-gradient(rgba(133,161,177,.16) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(133,161,177,.16) 1rpx, transparent 1rpx); background-size: 42rpx 42rpx; }
.orbit { position: absolute; border: 1rpx solid rgba(17,214,197,.25); border-radius: 50%; }
.orbit-a { top: 56rpx; left: 140rpx; width: 320rpx; height: 220rpx; transform: rotate(18deg); }
.orbit-b { top: 22rpx; left: 90rpx; width: 430rpx; height: 300rpx; transform: rotate(-22deg); border-color: rgba(139,124,246,.22); }
.core-node, .map-node { position: absolute; z-index: 2; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-align: center; font-weight: 700; }
.core-node { top: 132rpx; left: 270rpx; width: 110rpx; height: 110rpx; flex-direction: column; color: #0e1b2a; background: #11d6c5; box-shadow: 0 0 0 18rpx rgba(17,214,197,.12), 0 0 44rpx rgba(17,214,197,.45); font-size: 28rpx; }
.core-node text, .map-node text { display: block; margin-top: 4rpx; font-size: 17rpx; font-weight: 400; }
.map-node { width: 76rpx; height: 76rpx; color: #fff; font-size: 25rpx; }
.map-node-a { top: 72rpx; left: 124rpx; background: #f26b5e; }
.map-node-b { top: 238rpx; left: 164rpx; background: #f3a64a; }
.map-node-c { top: 76rpx; right: 98rpx; background: #8b7cf6; }
.map-line { position: absolute; z-index: 1; height: 2rpx; transform-origin: left center; background: rgba(165,209,214,.48); }
.line-a { top: 182rpx; left: 190rpx; width: 104rpx; transform: rotate(23deg); }
.line-b { top: 238rpx; left: 222rpx; width: 80rpx; transform: rotate(-35deg); }
.line-c { top: 178rpx; left: 380rpx; width: 104rpx; transform: rotate(-31deg); }
.map-caption { position: absolute; right: 24rpx; bottom: 22rpx; left: 24rpx; display: flex; justify-content: space-between; color: #87a0af; font-size: 20rpx; }
.graph-tools { display: flex; gap: 14rpx; margin-top: 18rpx; }
.tool-btn { flex: 1; min-width: 0; height: 88rpx; margin: 0; padding: 0 12rpx; border-radius: 20rpx; color: #1c1c1e; font-size: 27rpx; line-height: 88rpx; }
.graph-list-title { margin-top: 36rpx; }
.node-list { display: flex; flex-direction: column; gap: 14rpx; }
.node-card { display: flex; align-items: center; min-height: 110rpx; padding: 18rpx 20rpx; }
.node-mark { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-right: 18rpx; border-radius: 18rpx; color: #fff; font-size: 28rpx; font-weight: 700; }
.node-copy { display: flex; flex: 1; flex-direction: column; }
.node-name { color: #102235; font-size: 28rpx; font-weight: 700; }
.node-detail { margin-top: 6rpx; color: #83919c; font-size: 22rpx; }
.node-count { display: flex; flex-direction: column; align-items: flex-end; margin-right: 14rpx; color: #0da99d; font-size: 23rpx; }
.node-count text:last-child { margin-top: 3rpx; color: #9aa8b2; font-size: 19rpx; }
.node-arrow { color: #a9b4bc; font-size: 34rpx; }
.empty { padding: 48rpx 20rpx; color: #84939f; text-align: center; }
