<view class="page home-page">
  <view class="dark-header safe-top">
    <view class="home-topline">
      <view><text class="eyebrow">THREAT INTELLIGENCE / 01</text><view class="home-title">知识图谱<text class="home-title-accent">安全分析</text></view></view>
      <view class="avatar" bindtap="openProfile">安</view>
    </view>
    <view class="system-status"><view><text class="mini-dot"></text><text>分析引擎 {{summary.status === 'healthy' ? '运行正常' : '等待接入'}}</text></view><text class="status-arrow">↗</text></view>
  </view>
  <view class="section stats-section">
    <view class="section-title"><text>图谱概览</text><text>内置恶意软件图谱</text></view>
    <view class="stats-card card">
      <view class="stat-item"><text class="stat-value">{{summary.nodes ? '1.7M' : '--'}}</text><text class="stat-label">节点</text></view>
      <view class="stat-divider"></view>
      <view class="stat-item"><text class="stat-value">{{summary.relationships ? '2.4M' : '--'}}</text><text class="stat-label">关系</text></view>
      <view class="stat-divider"></view>
      <view class="stat-item"><text class="stat-value">CN / EN</text><text class="stat-label">双语层</text></view>
    </view>
  </view>
  <view class="section feature-section">
    <view class="section-title"><text>从哪里开始</text><text>选择一个入口</text></view>
    <view class="feature-list">
      <view wx:for="{{features}}" wx:key="key" class="feature-card card" bindtap="openFeature" data-key="{{item.key}}">
        <view class="feature-icon feature-icon-{{item.key}}">{{item.icon}}</view><view class="feature-copy"><text class="feature-title">{{item.title}}</text><text class="feature-desc">{{item.desc}}</text></view><text class="feature-arrow">↗</text>
      </view>
    </view>
  </view>
  <view wx:if="{{recent.length}}" class="section recent-section">
    <view class="section-title"><text>最近问答</text><text>继续查看</text></view>
    <view wx:for="{{recent}}" wx:key="question" class="recent-card card" bindtap="openRecent" data-question="{{item.question}}">
      <text class="recent-question">{{item.question}}</text><text class="recent-answer">{{item.answer}}</text><view class="recent-meta"><text>{{item.sourceCount || 0}} 条图谱依据</text><text>›</text></view>
    </view>
  </view>
</view>
<bottom-nav active="home"></bottom-nav>
