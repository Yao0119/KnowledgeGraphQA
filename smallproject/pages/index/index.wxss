.home-page { padding-bottom: 54rpx; }
.home-topline { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: flex-start; }
.home-topline .avatar { order: -1; flex: none; margin: 4rpx 20rpx 0 0; }
.home-title { margin-top: 5rpx; color: #f5f7fa; font-size: 42rpx; font-weight: 700; line-height: 1.08; letter-spacing: -1rpx; }
.home-title-accent { color: #11d6c5; }
.home-intro { position: relative; z-index: 1; width: 570rpx; margin-top: 12rpx; color: #9cb0c0; font-size: 23rpx; line-height: 1.45; }
.avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border: 1rpx solid rgba(17,214,197,.36); border-radius: 50%; color: #11d6c5; background: rgba(17,214,197,.08); font-size: 25rpx; }
.system-status { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 10rpx 16rpx; border: 1rpx solid rgba(255,255,255,.08); border-radius: 14rpx; color: #b6c9d4; background: rgba(255,255,255,.045); font-size: 21rpx; }
.system-status > view { display: flex; align-items: center; }.status-arrow { color: #11d6c5; font-size: 30rpx; }
.stats-card { display: flex; align-items: center; justify-content: space-around; padding: 28rpx 14rpx; }
.stat-item { display: flex; flex: 1; flex-direction: column; align-items: center; }.stat-value { color: #102235; font-size: 38rpx; font-weight: 700; letter-spacing: -1rpx; }.stat-label { margin-top: 8rpx; color: #81909d; font-size: 22rpx; }.stat-divider { width: 1rpx; height: 52rpx; background: #e4ebef; }
.feature-list { display: flex; flex-direction: column; gap: 16rpx; }.feature-card { display: flex; align-items: center; min-height: 136rpx; padding: 26rpx 24rpx; }.feature-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 22rpx; border-radius: 20rpx; font-size: 38rpx; font-weight: 700; }.feature-icon-graph { color: #8b7cf6; background: #eeecff; }.feature-icon-qa { color: #0da99d; background: #e4fbf7; }.feature-icon-detect { color: #ec8d44; background: #fff2e6; }.feature-icon-dual { color: #3f9ae6; background: #e8f3ff; }.feature-icon-virus { color: #ec8d44; background: #fff2e6; }.feature-icon-predict { color: #8b7cf6; background: #eeecff; }.feature-copy { display: flex; flex: 1; flex-direction: column; }.feature-title { color: #102235; font-size: 30rpx; font-weight: 700; }.feature-desc { margin-top: 8rpx; color: #81909d; font-size: 23rpx; }.feature-arrow { color: #9aa9b5; font-size: 34rpx; }
.recent-card { margin-bottom: 16rpx; padding: 24rpx 26rpx; }.recent-question { display: block; color: #102235; font-size: 28rpx; font-weight: 700; }.recent-answer { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: #70818f; font-size: 24rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.recent-meta { display: flex; justify-content: space-between; margin-top: 18rpx; color: #0da99d; font-size: 22rpx; }
