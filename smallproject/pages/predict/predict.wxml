<view class="page predict-page">
  <view class="predict-header safe-top"><text class="eyebrow">THREAT PREDICTION</text><text class="predict-title">威胁预测</text><text class="predict-desc">提交样本名称或行为线索，生成一份待验证的风险判断。</text></view>
  <view class="section predict-content"><view class="form-card card"><text class="field-label">样本名称 / 文件名</text><input value="{{sample}}" bindinput="onSampleInput" placeholder="例如：invoice.exe" placeholder-class="field-placeholder" /><text class="field-label field-gap">行为特征</text><textarea value="{{behavior}}" bindinput="onBehaviorInput" auto-height maxlength="500" placeholder="例如：启动 PowerShell、连接外部 IP、尝试读取浏览器凭据" placeholder-class="field-placeholder"></textarea><button class="primary-btn" bindtap="predict" loading="{{loading}}">生成风险判断</button></view><view wx:if="{{result}}" class="prediction-result card"><view class="prediction-top"><text class="result-kicker">PREDICTION</text><text class="confidence">{{result.confidenceText}}</text></view><text class="prediction-title">{{result.prediction}}</text><text class="prediction-suggest">{{result.details && result.details.suggestion}}</text><view wx:if="{{result.details && result.details.matched}}" class="matched-row"><text wx:for="{{result.details.matched}}" wx:key="*this" class="matched-tag">{{item}}</text></view></view></view>
</view>
