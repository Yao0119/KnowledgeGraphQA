.predict-header { padding: 32rpx; background: #0e1b2a; color: #f5f7fa; }.predict-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }.predict-desc { display: block; max-width: 620rpx; margin-top: 16rpx; color: #9cb0c0; font-size: 24rpx; line-height: 1.6; }.predict-content { padding-top: 28rpx; }.form-card { padding: 28rpx; }.field-label { display: block; color: #334858; font-size: 24rpx; font-weight: 700; }.field-gap { margin-top: 26rpx; }.form-card input, .form-card textarea { width: 100%; margin-top: 12rpx; padding: 18rpx 20rpx; border: 1rpx solid #dce5ea; border-radius: 16rpx; color: #2d4354; background: #fbfcfd; font-size: 25rpx; line-height: 1.6; }.form-card textarea { min-height: 160rpx; }.field-placeholder { color: #a3afb6; }.form-card .primary-btn { margin-top: 28rpx; border-radius: 18rpx; color: #0e1b2a; background: #11d6c5; font-size: 27rpx; line-height: 84rpx; }.prediction-result { margin-top: 22rpx; padding: 28rpx; }.prediction-top { display: flex; justify-content: space-between; }.result-kicker { color: #7f8e9b; font-size: 19rpx; letter-spacing: 2rpx; }.confidence { color: #8b7cf6; font-size: 26rpx; font-weight: 700; }.prediction-title { display: block; margin-top: 18rpx; color: #102235; font-size: 32rpx; font-weight: 700; }.prediction-suggest { display: block; margin-top: 12rpx; color: #607381; font-size: 24rpx; line-height: 1.6; }.matched-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 20rpx; }.matched-tag { padding: 9rpx 14rpx; border-radius: 20rpx; color: #6a5bd2; background: #f0edff; font-size: 21rpx; }
