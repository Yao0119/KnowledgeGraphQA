<view class="page profile-page">
  <view class="profile-header safe-top"><text class="eyebrow">WORKSPACE / 04</text><text class="profile-title">我的</text><view class="profile-card"><view class="profile-avatar">{{user.initials}}</view><view class="profile-copy"><text class="profile-name">{{user.name}}</text><text class="profile-role">{{user.role}} · 知识图谱访问者</text></view><text class="profile-mark">⌁</text></view></view>
  <view class="section"><view class="section-title"><text>工作空间</text><text>当前配置</text></view><view class="setting-list card"><view wx:for="{{settings}}" wx:key="key" class="setting-row"><view class="setting-icon">{{index === 0 ? '◈' : index === 1 ? '文' : '●'}}</view><view class="setting-copy"><text class="setting-label">{{item.label}}</text><text class="setting-value">{{item.value}}</text></view><text class="setting-arrow">›</text></view></view></view>
  <view class="section"><view class="section-title"><text>更多</text><text></text></view><view class="more-list card"><view class="more-row" bindtap="openCustomers"><text>客户管理（管理员）</text><text>›</text></view><view class="more-row" bindtap="showAbout"><text>关于本小程序</text><text>›</text></view><view class="more-row" bindtap="clearLocalData"><text>清除本地问答记录</text><text>›</text></view></view></view>
  <view class="profile-note"><text class="mini-dot"></text><text>后端接口准备中，本地演示数据可正常浏览。</text></view>
</view>
