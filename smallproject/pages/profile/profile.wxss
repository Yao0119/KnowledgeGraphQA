.profile-header { padding: 32rpx 32rpx 42rpx; background: #0e1b2a; color: #f5f7fa; }.profile-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }.profile-card { display: flex; align-items: center; margin-top: 30rpx; padding: 24rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 24rpx; background: rgba(255,255,255,.06); }.profile-avatar { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin-right: 20rpx; border-radius: 22rpx; color: #0e1b2a; background: #11d6c5; font-size: 32rpx; font-weight: 700; }.profile-copy { display: flex; flex: 1; flex-direction: column; }.profile-name { font-size: 31rpx; font-weight: 700; }.profile-role { margin-top: 8rpx; color: #9cb0c0; font-size: 22rpx; }.profile-mark { color: #11d6c5; font-size: 38rpx; }.setting-list, .more-list { overflow: hidden; }.setting-row { display: flex; align-items: center; min-height: 114rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #edf1f3; }.setting-row:last-child, .more-row:last-child { border-bottom: 0; }.setting-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 18rpx; border-radius: 16rpx; color: #0da99d; background: #e5faf7; font-size: 24rpx; }.setting-copy { display: flex; flex: 1; flex-direction: column; }.setting-label { color: #334858; font-size: 27rpx; }.setting-value { margin-top: 6rpx; color: #8b9aa4; font-size: 22rpx; }.setting-arrow, .more-row text:last-child { color: #a5b0b8; font-size: 34rpx; }.more-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 0 24rpx; border-bottom: 1rpx solid #edf1f3; color: #334858; font-size: 27rpx; }.profile-note { display: flex; align-items: center; justify-content: center; margin: 50rpx 32rpx 0; color: #82919b; font-size: 21rpx; }
.login-card { padding: 22rpx 24rpx 24rpx; }
.connection-row { display: flex; align-items: center; color: #48484a; font-size: 22rpx; }
.connection-dot { width: 14rpx; height: 14rpx; margin-right: 12rpx; border-radius: 50%; background: #a1a1a6; }
.connection-dot-on { background: #30b560; }
.connection-status { margin-left: auto; color: #1c1c1e; }
.login-input { width: 100%; height: 82rpx; margin-top: 16rpx; padding: 0 20rpx; border: 1rpx solid rgba(0,0,0,.08); border-radius: 16rpx; color: #1c1c1e; background: #f2f2f2; font-size: 25rpx; }
.login-placeholder { color: #8e8e93; }
.login-submit { width: 100%; margin-top: 18rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 80rpx; }
.outline-btn.login-submit { border: 1rpx solid rgba(0,0,0,.12); color: #1c1c1e; background: #fff; }
