.qa-page { display: flex; flex-direction: column; min-height: 100vh; padding-bottom: 40rpx; }.qa-header { display: flex; align-items: flex-end; justify-content: space-between; padding: 32rpx 32rpx 30rpx; background: #0e1b2a; color: #f5f7fa; }.qa-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }.clear-btn { padding: 12rpx 18rpx; border: 1rpx solid rgba(255,255,255,.14); border-radius: 30rpx; color: #9cb0c0; font-size: 22rpx; }.conversation { flex: 1; min-height: 650rpx; padding: 30rpx 32rpx 10rpx; }.qa-empty { display: flex; align-items: center; flex-direction: column; margin-top: 100rpx; padding: 52rpx 34rpx; text-align: center; }.empty-symbol { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 50%; color: #0da99d; background: #e5faf7; font-size: 40rpx; font-weight: 700; }.empty-title { margin-top: 22rpx; color: #102235; font-size: 30rpx; font-weight: 700; }.empty-desc { margin-top: 12rpx; color: #81909d; font-size: 23rpx; line-height: 1.6; }.message-row { display: flex; align-items: flex-start; margin-bottom: 26rpx; }.message-user { flex-direction: row-reverse; }.message-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 16rpx; color: #0e1b2a; background: #11d6c5; font-size: 20rpx; font-weight: 700; }.message-user .message-avatar { margin-left: 14rpx; color: #fff; background: #8b7cf6; }.message-bot .message-avatar { margin-right: 14rpx; }.message-content { max-width: 580rpx; }.message-bubble { padding: 20rpx 22rpx; border-radius: 8rpx 22rpx 22rpx 22rpx; color: #2b3b49; background: #fff; box-shadow: 0 8rpx 22rpx rgba(16,34,53,.05); font-size: 26rpx; line-height: 1.65; }.message-user .message-bubble { border-radius: 22rpx 8rpx 22rpx 22rpx; color: #fff; background: #213b54; }.message-time { display: block; margin-top: 8rpx; color: #9ba8b1; font-size: 19rpx; }.message-user .message-time { text-align: right; }.source-toggle { display: flex; justify-content: space-between; margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 12rpx; color: #0b8f85; background: #e8faf7; font-size: 21rpx; }.source-list { padding: 12rpx 14rpx; border: 1rpx solid #d9efec; border-top: 0; border-radius: 0 0 12rpx 12rpx; background: #f8fffe; }.source-item { display: flex; align-items: center; padding: 11rpx 0; font-size: 20rpx; }.source-entity { color: #294459; }.source-relation { margin: 0 10rpx; color: #0da99d; }.loading-bubble { color: #71818e; }.loading-dots { display: inline-block; margin-left: 8rpx; color: #11d6c5; letter-spacing: 4rpx; }.suggestions { display: flex; gap: 12rpx; overflow-x: auto; padding: 12rpx 32rpx 18rpx; white-space: nowrap; }.suggestion { padding: 14rpx 18rpx; border: 1rpx solid #dce7eb; border-radius: 30rpx; color: #667b89; background: #fff; font-size: 22rpx; }.composer { display: flex; align-items: flex-end; margin: 0 24rpx 22rpx; padding: 12rpx 12rpx 12rpx 22rpx; border: 1rpx solid #dbe5ea; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(16,34,53,.06); }.composer textarea { flex: 1; min-height: 42rpx; max-height: 160rpx; padding: 8rpx 0; color: #22384b; font-size: 26rpx; line-height: 1.5; }.composer-placeholder { color: #a1adb5; }.send-btn { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin-left: 12rpx; padding: 0; border-radius: 18rpx; color: #95a6b0; background: #edf2f4; font-size: 34rpx; line-height: 66rpx; }.send-active { color: #0e1b2a; background: #11d6c5; }
