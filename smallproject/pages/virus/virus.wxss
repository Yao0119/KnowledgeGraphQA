.virus-header { display: flex; align-items: flex-end; justify-content: space-between; padding: 32rpx; background: #0e1b2a; color: #f5f7fa; }.virus-title { display: block; margin-top: 12rpx; font-size: 46rpx; font-weight: 700; }.virus-mode { color: #f3a64a; font-size: 20rpx; }.virus-content { padding-top: 28rpx; }.upload-card { display: flex; align-items: center; flex-direction: column; padding: 38rpx 28rpx 30rpx; text-align: center; }.upload-symbol { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border: 1rpx dashed #f3a64a; border-radius: 22rpx; color: #ec8d44; background: #fff5e9; font-size: 40rpx; }.upload-title { margin-top: 18rpx; color: #102235; font-size: 30rpx; font-weight: 700; }.upload-desc { margin-top: 10rpx; color: #81909d; font-size: 23rpx; line-height: 1.6; }.outline-btn { margin-top: 24rpx; padding: 0 30rpx; border: 1rpx solid #d8e2e7; border-radius: 40rpx; color: #435765; background: #fff; font-size: 24rpx; line-height: 70rpx; }.file-name { max-width: 540rpx; margin-top: 14rpx; overflow: hidden; color: #0da99d; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.scan-actions { margin: 18rpx 0 32rpx; }.primary-btn { border-radius: 18rpx; color: #0e1b2a; background: #11d6c5; font-size: 27rpx; font-weight: 700; line-height: 84rpx; }.check-list { overflow: hidden; }.check-row { display: flex; align-items: center; padding: 20rpx 22rpx; border-bottom: 1rpx solid #edf1f3; }.check-row:last-child { border-bottom: 0; }.check-index { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 16rpx; border-radius: 14rpx; color: #0da99d; background: #e5faf7; font-size: 18rpx; }.check-copy { display: flex; flex: 1; flex-direction: column; color: #344a5a; font-size: 25rpx; }.check-copy text:last-child { margin-top: 5rpx; color: #96a3ab; font-size: 21rpx; }.check-status { color: #a4afb6; font-size: 21rpx; }.report-card { margin-top: 28rpx; padding: 26rpx; }.report-head { display: flex; align-items: flex-start; justify-content: space-between; }.report-kicker { display: block; color: #7f8e9b; font-size: 19rpx; letter-spacing: 2rpx; }.report-title { display: block; margin-top: 8rpx; color: #d45d43; font-size: 31rpx; font-weight: 700; }.risk-pill { padding: 8rpx 14rpx; border-radius: 20rpx; color: #b87314; background: #fff1d9; font-size: 20rpx; }.report-summary { display: block; margin-top: 20rpx; color: #607381; font-size: 24rpx; line-height: 1.6; }.result-row { display: flex; justify-content: space-between; padding: 18rpx 0 0; border-top: 1rpx solid #edf1f3; margin-top: 18rpx; color: #445866; font-size: 22rpx; }.result-row text:last-child { color: #0da99d; }
